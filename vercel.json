{
  "redirects": [
    {
      "source": "/pages/about",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/pages/services",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/pages/portfolio",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/pages/blog",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/pages/careers",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/pages/contact",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/pages/upskill",
      "destination": "/upskill",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/verify/:certificateId",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/verify/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "buildCommand": "npm --prefix xenfirm-react run build",
  "installCommand": "npm --prefix xenfirm-react ci",
  "outputDirectory": "xenfirm-react/dist",
  "framework": null
}
